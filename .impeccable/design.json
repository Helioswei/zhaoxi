  "narrative": {
    "northStar": "朝夕之间的口袋日常",
    "overview": "朝夕的设计不为展示，「掏出来 5 秒搞定」。奶油色的纸面托着一份很轻的清单，暖橘只在「今天」出现，逾期给一条陶红，其他时候颜色闭嘴。它像身边一件常用的小物：好按、好认、不用学。\n\n三套风格（清爽／温润／纸感）共用同一套骨架与组件，只换令牌：底色、圆角、点缀、字体。默认且最能代表朝夕气质的是温润。所有判断先对齐温润，再验证另两套不破。",
    "keyCharacteristics": [
      "颜色即状态，绝不为装饰上色",
      "平面优先，靠圆角与底色分层",
      "圆角是风格的身份证（16／22／12）",
      "中文一等公民，字号随系统缩放",
      "一切误操作可撤销，反馈用浮起 Snackbar"
    ],
    "rules": [
      { "name": "The 颜色即状态 Rule", "body": "茶青绿=已办，暖橘=今天/进行中，陶红=逾期/删除。语义映射全风格恒定，新 UI 不得挪作装饰。", "section": "colors" },
      { "name": "The 少色 Rule", "body": "任一屏内彩色占比不超过 5%，大面积永远是奶油纸/瓷白。", "section": "colors" },
      { "name": "The 系统字优先 Rule", "body": "正文跟系统字号缩放，不写死 px；纸感整身衬线，不混排。", "section": "typography" },
      { "name": "The 平面优先 Rule", "body": "新组件默认 0 阴影；先底色与圆角，才申请一枚 ≤10% 黑轻投影。", "section": "elevation" },
      { "name": "The 圆角即风格 Rule", "body": "圆角半径必须读 AppTokens，不许写死。", "section": "shapes" }
    ],
    "dos": [
      "所有组件颜色/圆角一律走 context.tokens / context.colors",
      "语义色恒定：今天=暖橘、逾期=陶红、完成=茶青绿、删除底=陶红",
      "保持 ≥48dp 触控目标、目标间 ≥8dp",
      "深浅两套都逐屏过一遍，纸感另查衬线回退",
      "撤销统一走 showUndoSnack，文案短句直述"
    ],
    "donts": [
      "在 widget 里写死十六进制色或固定圆角",
      "用暖橘做按钮/填充主色",
      "给平面卡片加多层阴影或大投影",
      "引入 Cupertino 控件或 iOS 式底部导航",
      "为「重要程度」发明新的颜色概念"
    ]
  }
